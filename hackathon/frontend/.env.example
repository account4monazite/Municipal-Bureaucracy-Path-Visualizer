# Google Maps API Key
# Add your Google Maps JavaScript / Places API key here when ready
VITE_GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_API_KEY=

# Set to 'true' to run fully offline with mock civic office data
# Set to 'false' to use live Google Maps and Places services
VITE_USE_MOCK_DATA=true

VITE_BACKEND_URL=http://localhost:3001
